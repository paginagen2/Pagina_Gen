rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRoles() {
      return signedIn()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.roles
        : [];
    }

    function isAdmin() {
      return signedIn() && userRoles().hasAny(['admin']);
    }

    function hasRole(role) {
      return signedIn() && userRoles().hasAny([role]);
    }

    function activeFunction(role) {
      return !exists(/databases/$(database)/documents/funcionalidades/$(role))
        || !('activa' in get(/databases/$(database)/documents/funcionalidades/$(role)).data)
        || get(/databases/$(database)/documents/funcionalidades/$(role)).data.activa != false;
    }

    function activeZone(role) {
      return !exists(/databases/$(database)/documents/zonas/$(role))
        || !('activa' in get(/databases/$(database)/documents/zonas/$(role)).data)
        || get(/databases/$(database)/documents/zonas/$(role)).data.activa != false;
    }

    function canManage(role) {
      return isAdmin() || (hasRole(role) && activeFunction(role));
    }

    function canReadRoleAudience(roles) {
      return roles.size() == 0 || (signedIn() && (
        roles.hasAny(userRoles())
        || (roles.hasAny(['gen']) && userRoles().hasAny(['gen2']))
      ));
    }

    function canManageZoneCommunication(data) {
      return signedIn()
        && data.zonaAdministradora is string
        && data.rolesDestinatarios is list
        && data.rolesDestinatarios.size() == 1
        && data.rolesDestinatarios[0] == data.zonaAdministradora
        && activeZone(data.zonaAdministradora)
        && activeFunction('funcion_comunicacion_' + data.zonaAdministradora)
        && hasRole('funcion_comunicacion_' + data.zonaAdministradora);
    }

    function canReadManagedZoneCommunication(data) {
      return signedIn()
        && data.zonaAdministradora is string
        && activeZone(data.zonaAdministradora)
        && activeFunction('funcion_comunicacion_' + data.zonaAdministradora)
        && hasRole('funcion_comunicacion_' + data.zonaAdministradora);
    }

    function published() {
      return !('estado' in resource.data) || resource.data.estado == 'publicado' || resource.data.estado == 'publicada';
    }

    match /usuarios/{uid} {
      allow get: if ownUser(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if ownUser(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.roles.size() == 0;
      allow update: if isAdmin() || (ownUser(uid)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombre', 'descripcion', 'ubicacion', 'perfilActualizadoEn', 'notificaciones'
          ])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'ultimoCanjeCodigo'])
            && request.resource.data.roles.size() == resource.data.roles.size() + 1
            && request.resource.data.roles.hasAll(resource.data.roles)
            && request.resource.data.ultimoCanjeCodigo is string
            && exists(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo))
            && (
              !('destinatarioEmail' in get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data)
              || get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.destinatarioEmail == null
              || get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.destinatarioEmail == ''
              || (
                request.auth.token.email is string
                && request.auth.token.email.lower()
                  == get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.destinatarioEmail
              )
            )
            && request.resource.data.roles.hasAny([
              get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.rol
            ])
            && (
              (
                !('tipo' in get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data)
                && get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.usado == false
                && getAfter(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.usado == true
                && getAfter(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.usadoPor == request.auth.uid
              )
              || (
                'tipo' in get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data
                && getAfter(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.usosActuales
                  == get(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.usosActuales + 1
                && getAfter(/databases/$(database)/documents/codigos_roles/$(request.resource.data.ultimoCanjeCodigo)).data.ultimoUsoPor == request.auth.uid
              )
            )
          )
        ));
      allow delete: if isAdmin();

      match /dispositivosNotificaciones/{deviceId} {
        allow get, list: if ownUser(uid) || isAdmin();
        allow create: if ownUser(uid)
          && request.resource.data.deviceId == deviceId
          && request.resource.data.enabled is bool
          && request.resource.data.platform in ['web', 'android', 'ios']
          && request.resource.data.transport in ['web-push', 'fcm']
          && request.resource.data.timezone is string
          && request.resource.data.permission in ['default', 'prompt', 'granted', 'denied']
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.keys().hasOnly([
            'mode', 'categories', 'fixedTimes', 'schedule', 'timezone',
            'deviceId', 'platform', 'transport', 'enabled', 'permission',
            'updatedAt', 'version', 'subscription', 'fcmToken', 'webPushKeyId'
          ]);
        allow update: if ownUser(uid)
          && request.resource.data.deviceId == deviceId
          && request.resource.data.enabled is bool
          && request.resource.data.platform in ['web', 'android', 'ios']
          && request.resource.data.transport in ['web-push', 'fcm']
          && request.resource.data.timezone is string
          && request.resource.data.permission in ['default', 'prompt', 'granted', 'denied']
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mode', 'categories', 'fixedTimes', 'schedule', 'timezone',
            'deviceId', 'platform', 'transport', 'enabled', 'permission',
            'updatedAt', 'version', 'subscription', 'fcmToken', 'webPushKeyId'
          ]);
        allow delete: if ownUser(uid) || isAdmin();
      }

      match /favoritos/{songId} {
        allow get, list: if ownUser(uid) || isAdmin();
        allow create, update: if ownUser(uid)
          && request.resource.data.usuarioId == uid
          && request.resource.data.cancionId == songId
          && request.resource.data.creadoEn is string
          && request.resource.data.keys().hasOnly([
            'usuarioId', 'cancionId', 'creadoEn'
          ]);
        allow delete: if ownUser(uid) || isAdmin();
      }

      match /playlists/{playlistId} {
        allow get, list, delete: if ownUser(uid) || isAdmin();
        allow create, update: if ownUser(uid)
          && request.resource.data.usuarioId == uid
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 60
          && request.resource.data.descripcion is string
          && request.resource.data.descripcion.size() <= 180
          && request.resource.data.tipo in ['audio', 'canciones']
          && request.resource.data.creadaEn is string
          && request.resource.data.actualizadaEn is string
          && request.resource.data.eliminada is bool
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 200
          && request.resource.data.keys().hasOnly([
            'usuarioId', 'nombre', 'descripcion', 'tipo', 'creadaEn', 'actualizadaEn', 'eliminada', 'items'
          ]);
      }
    }

    match /codigos_roles/{code} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && (
        (
          !('tipo' in resource.data)
          && resource.data.usado == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado', 'usadoPor', 'usadoEn'])
          && request.resource.data.usado == true
          && request.resource.data.usadoPor == request.auth.uid
        )
        || (
          'tipo' in resource.data
          && resource.data.activo == true
          && (
            !('destinatarioEmail' in resource.data)
            || resource.data.destinatarioEmail == null
            || resource.data.destinatarioEmail == ''
            || (request.auth.token.email is string && request.auth.token.email.lower() == resource.data.destinatarioEmail)
          )
          && (!('venceEn' in resource.data) || resource.data.venceEn == null || resource.data.venceEn > request.time)
          && (resource.data.tipo == 'libre' || resource.data.usosActuales < resource.data.maxUsos)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usosActuales', 'ultimoUsoPor', 'ultimoUsoEn'
          ])
          && request.resource.data.usosActuales == resource.data.usosActuales + 1
          && request.resource.data.ultimoUsoPor == request.auth.uid
          && request.resource.data.ultimoUsoEn is timestamp
          && request.resource.data.ultimoUsoEn <= request.time
        )
      )
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.roles.hasAny([resource.data.rol])
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ultimoCanjeCodigo == code);

      match /canjes/{uid} {
        allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow list, delete: if isAdmin();
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.rol == get(/databases/$(database)/documents/codigos_roles/$(code)).data.rol
          && request.resource.data.canjeadoEn is timestamp
          && request.resource.data.canjeadoEn <= request.time
          && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.roles.hasAny([
            get(/databases/$(database)/documents/codigos_roles/$(code)).data.rol
          ])
          && getAfter(/databases/$(database)/documents/codigos_roles/$(code)).data.ultimoUsoPor == uid;
        allow update: if false;
      }
    }

    match /zonas/{zoneId} {
      allow read, write: if isAdmin();
    }

    match /funcionalidades/{functionId} {
      allow read, write: if isAdmin();
    }

    match /configuracion_publica/{configId} {
      allow get: if configId == 'android';
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /versiones_android/{versionId} {
      allow read: if isAdmin() || canManage('funcion_subida_multiple');
      allow create: if isAdmin() || canManage('funcion_subida_multiple');
      allow update, delete: if isAdmin();
    }

    match /canal_publicaciones/{postId} {
      allow read: if canManage('funcion_comunicacion')
        || canReadManagedZoneCommunication(resource.data)
        || (
        (resource.data.estado == 'publicada'
          || (resource.data.estado == 'programada'
            && resource.data.fechaPublicacion <= request.time))
        && canReadRoleAudience(resource.data.rolesDestinatarios)
      );
      allow create: if canManage('funcion_comunicacion')
        || canManage('funcion_subida_multiple')
        || canManageZoneCommunication(request.resource.data);
      allow update: if canManage('funcion_comunicacion')
        || (canManageZoneCommunication(resource.data)
          && canManageZoneCommunication(request.resource.data));
      allow delete: if canManage('funcion_comunicacion')
        || canManageZoneCommunication(resource.data);
    }

    match /canciones/{songId} {
      allow read: if published() || canManage('funcion_cancionero')
        || canManage('funcion_subida_multiple');
      allow create: if request.resource.data.categoria in ['misa', 'gen', 'fogon']
        && (canManage('funcion_cancionero')
          || canManage('funcion_subida_multiple')
          || (
            signedIn()
            && request.resource.data.estado == 'pendiente'
            && request.resource.data.usuarioId == request.auth.uid
            && request.resource.data.keys().hasOnly([
              'titulo', 'artista', 'categoria', 'letra', 'tono', 'idioma',
              'referenciaUrl', 'usuarioId', 'creadoPorNombre', 'estado',
              'activa', 'reproducciones', 'fechaCreacion'
            ])
            && request.resource.data.titulo is string
            && request.resource.data.titulo.size() > 0
            && request.resource.data.titulo.size() <= 160
            && request.resource.data.artista is string
            && request.resource.data.artista.size() <= 160
            && request.resource.data.letra is string
            && request.resource.data.letra.size() > 0
            && request.resource.data.letra.size() <= 30000
            && request.resource.data.tono is string
            && request.resource.data.tono.size() <= 20
            && request.resource.data.idioma is string
            && request.resource.data.idioma.size() <= 30
            && (!('referenciaUrl' in request.resource.data) || (
              request.resource.data.referenciaUrl is string
              && request.resource.data.referenciaUrl.size() <= 2000
            ))
            && request.resource.data.creadoPorNombre is string
            && request.resource.data.creadoPorNombre.size() <= 120
            && request.resource.data.activa == true
            && request.resource.data.reproducciones == 0
            && request.resource.data.fechaCreacion is timestamp
          ));
      allow update: if request.resource.data.categoria in ['misa', 'gen', 'fogon']
        && (canManage('funcion_cancionero')
          || canManage('funcion_subida_multiple')
          || (
            resource.data.estado == 'publicado'
            && signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reproducciones'])
            && request.resource.data.reproducciones is int
            && (
              (
                resource.data.reproducciones is int
                && request.resource.data.reproducciones == resource.data.reproducciones + 1
              )
              || (
                !('reproducciones' in resource.data)
                && request.resource.data.reproducciones == 1
              )
            )
          ));
      allow delete: if canManage('funcion_cancionero')
        || canManage('funcion_subida_multiple');

      match /likes/{userId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.usuarioId == userId
          && request.resource.data.keys().hasOnly(['usuarioId', 'creadoEn']);
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /cancion_audios/{audioId} {
      // La web pública consume el catálogo estático generado periódicamente.
      // Firestore queda como fuente administrativa y evita lecturas públicas repetidas.
      // El rol parcial de Cancionero debe poder abrir y administrar esta bandeja
      // aunque exista una configuración antigua de la función marcada como inactiva.
      allow read: if canManage('funcion_cancionero') || hasRole('funcion_cancionero') || canManage('funcion_subida_multiple');
      allow create: if canManage('funcion_cancionero') || hasRole('funcion_cancionero') || canManage('funcion_subida_multiple') || (
        signedIn()
        && request.resource.data.keys().hasOnly([
          'cancionId', 'cancionTitulo', 'url', 'proveedor', 'modoReproduccion',
          'tipo', 'version', 'versionVocal', 'tipoVoz', 'interprete', 'idioma', 'nombre', 'descripcion', 'estado',
          'esPrincipal', 'permisosConfirmados', 'creadoPor', 'creadoPorNombre', 'fechaCreacion',
          'actualizadaEn'
        ])
        && request.resource.data.cancionId is string
        && request.resource.data.cancionId.size() > 0
        && request.resource.data.cancionTitulo is string
        && request.resource.data.cancionTitulo.size() > 0
        && request.resource.data.cancionTitulo.size() <= 160
        && request.resource.data.url is string
        && request.resource.data.url.size() > 8
        && request.resource.data.url.size() <= 2000
        && request.resource.data.proveedor in [
          'youtube', 'spotify', 'soundcloud', 'drive', 'bandcamp',
          'applemusic', 'vimeo', 'directo', 'externo'
        ]
        && request.resource.data.modoReproduccion in ['embed', 'audio', 'externo']
        && request.resource.data.tipo in [
          'guia', 'oficial', 'en_vivo', 'cover', 'remix', 'instrumental', 'voces', 'otra'
        ]
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 80
        && request.resource.data.versionVocal is string
        && request.resource.data.versionVocal.size() <= 80
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() <= 500
        && request.resource.data.tipoVoz is string
        && request.resource.data.tipoVoz.size() <= 60
        && (request.resource.data.tipo != 'voces' || (
          request.resource.data.versionVocal.size() > 0
          && request.resource.data.tipoVoz.size() > 0
        ))
        && request.resource.data.interprete is string
        && request.resource.data.interprete.size() <= 120
        && request.resource.data.idioma is string
        && request.resource.data.idioma.size() <= 30
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 260
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.esPrincipal == false
        && request.resource.data.permisosConfirmados == true
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPorNombre is string
        && request.resource.data.creadoPorNombre.size() > 0
        && request.resource.data.creadoPorNombre.size() <= 120
        && request.resource.data.fechaCreacion is timestamp
        && request.resource.data.actualizadaEn is timestamp
        && exists(/databases/$(database)/documents/canciones/$(request.resource.data.cancionId))
        && (
          get(/databases/$(database)/documents/canciones/$(request.resource.data.cancionId)).data.estado in ['publicado', 'publicada']
          || (
            get(/databases/$(database)/documents/canciones/$(request.resource.data.cancionId)).data.estado == 'pendiente'
            && get(/databases/$(database)/documents/canciones/$(request.resource.data.cancionId)).data.usuarioId == request.auth.uid
          )
        )
      );
      allow update, delete: if canManage('funcion_cancionero') || hasRole('funcion_cancionero');
    }

    match /cancion_audios_publicos/{audioId} {
      // Espejo sin datos del usuario: permite el respaldo inmediato del catálogo fijo.
      allow read: if resource.data.estado == 'publicado';
      allow create, update, delete: if canManage('funcion_cancionero') || hasRole('funcion_cancionero');
    }

    match /recursos/{resourceId} {
      // Los recursos publicados son públicos, pero nunca exponemos documentos
      // antiguos que todavía contengan datos privados de contacto.
      allow read: if canManage('funcion_recursos') || (published() && !('email' in resource.data));
      allow create: if canManage('funcion_subida_multiple') || (
        signedIn()
        && request.resource.data.keys().hasOnly([
          'categoria', 'titulo', 'descripcion', 'duracion', 'participantes',
          'autor', 'objetivo', 'materiales', 'pasos', 'fechaCreacion',
          'estado', 'usuarioId'
        ])
        && request.resource.data.keys().hasAll([
          'categoria', 'titulo', 'descripcion', 'duracion', 'participantes',
          'autor', 'objetivo', 'materiales', 'pasos', 'fechaCreacion',
          'estado', 'usuarioId'
        ])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.categoria in ['dinamicas', 'juegos', 'reflexiones', 'retiros']
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() > 0
        && request.resource.data.descripcion.size() <= 1000
        && request.resource.data.duracion is string
        && request.resource.data.duracion.size() <= 80
        && request.resource.data.participantes is string
        && request.resource.data.participantes.size() <= 80
        && request.resource.data.autor is string
        && request.resource.data.autor.size() > 0
        && request.resource.data.autor.size() <= 100
        && request.resource.data.objetivo is string
        && request.resource.data.objetivo.size() <= 1000
        && request.resource.data.materiales is list
        && request.resource.data.materiales.size() <= 30
        && request.resource.data.pasos is list
        && request.resource.data.pasos.size() <= 40
        && request.resource.data.fechaCreacion is timestamp
      );
      allow update, delete: if canManage('funcion_recursos');
    }

    match /pdv/{pdvId} {
      allow get, list: if canManage('funcion_pdv') || (
        resource.data.version == 2
        && resource.data.fechaPublicacion <= request.time
      );
      allow create: if canManage('funcion_pdv') || canManage('funcion_subida_multiple');
      allow update, delete: if canManage('funcion_pdv');
    }

    match /biblioteca_recursos/{resourceId} {
      allow get, list: if canManage('funcion_biblioteca') || resource.data.estado == 'publicado';
      allow create: if canManage('funcion_biblioteca') || canManage('funcion_subida_multiple');
      allow update, delete: if canManage('funcion_biblioteca');
    }

    match /biblioteca_config/{configId} {
      allow read: if true;
      allow create, update, delete: if canManage('funcion_biblioteca');
    }

    match /biblioteca_aportes/{submissionId} {
      allow read: if canManage('funcion_biblioteca');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'codigo', 'titulo', 'autor', 'categoria', 'anio', 'idioma', 'tipo',
          'temas', 'temaPropuesto', 'descripcion',
          'estado', 'creadoPor', 'creadoEn'
        ])
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 4
        && request.resource.data.codigo.size() <= 30
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 140
        && request.resource.data.autor is string
        && request.resource.data.autor.size() <= 120
        && request.resource.data.categoria in ['libros', 'documentos', 'audio', 'videos']
        && (request.resource.data.anio == null || (
          request.resource.data.anio is int
          && request.resource.data.anio >= 1500
          && request.resource.data.anio <= 2100
        ))
        && request.resource.data.idioma in ['es', 'pt', 'it', 'en', 'otro']
        && request.resource.data.tipo in ['PDF', 'DOCX', 'EPUB', 'AUDIO', 'VIDEO', 'ENLACE']
        && request.resource.data.temas is list
        && request.resource.data.temas.size() <= 20
        && request.resource.data.temaPropuesto is string
        && request.resource.data.temaPropuesto.size() <= 60
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() > 0
        && request.resource.data.descripcion.size() <= 1000
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn is timestamp;
      allow update, delete: if canManage('funcion_biblioteca');
    }

    match /biblioteca_eventos/{eventId} {
      allow read: if canManage('funcion_biblioteca');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'tipo', 'recursoId', 'consulta', 'creadoPor', 'creadoEn'
        ])
        && request.resource.data.tipo in ['apertura', 'descarga', 'compartir', 'busqueda']
        && request.resource.data.recursoId is string
        && request.resource.data.recursoId.size() <= 160
        && request.resource.data.consulta is string
        && request.resource.data.consulta.size() <= 80
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn is timestamp;
      allow update, delete: if canManage('funcion_biblioteca');
    }

    match /biblioteca_metricas/{batchId} {
      allow read: if canManage('funcion_biblioteca');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'aperturas', 'descargas', 'compartidos', 'busquedas', 'total',
          'recursos', 'sessionId', 'fecha', 'creadoPor', 'creadoEn'
        ])
        && request.resource.data.aperturas is int
        && request.resource.data.aperturas >= 0
        && request.resource.data.descargas is int
        && request.resource.data.descargas >= 0
        && request.resource.data.compartidos is int
        && request.resource.data.compartidos >= 0
        && request.resource.data.busquedas is int
        && request.resource.data.busquedas >= 0
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 100
        && request.resource.data.total == request.resource.data.aperturas
          + request.resource.data.descargas
          + request.resource.data.compartidos
          + request.resource.data.busquedas
        && request.resource.data.recursos is list
        && request.resource.data.recursos.size() <= 30
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 80
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() == 10
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn is timestamp;
      allow update, delete: if canManage('funcion_biblioteca');
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in ['carrusel', 'frases']
        || (collectionName == 'pasapalabra' && resource.data.estado == 'publicado');
      allow create: if isAdmin()
        || (collectionName == 'carrusel' && canManage('funcion_comunicacion'))
        || (collectionName == 'frases' && canManage('funcion_frases'))
        || (collectionName == 'pasapalabra' && canManage('funcion_pasapalabra'))
        || (collectionName in ['frases', 'pasapalabra'] && canManage('funcion_subida_multiple'));
      allow update, delete: if isAdmin()
        || (collectionName == 'carrusel' && canManage('funcion_comunicacion'))
        || (collectionName == 'frases' && canManage('funcion_frases'))
        || (collectionName == 'pasapalabra' && canManage('funcion_pasapalabra'));
    }

    match /meditaciones/{documentId} {
      allow read: if canManage('funcion_meditaciones') || resource.data.Publico == true;
      allow create: if canManage('funcion_meditaciones') || canManage('funcion_subida_multiple');
      allow update, delete: if canManage('funcion_meditaciones');
    }

    match /notificaciones_pendientes/{notificationId} {
      allow read: if canManage('funcion_notificaciones');
      allow create: if canManage('funcion_notificaciones') || canManage('funcion_subida_multiple');
      allow update, delete: if canManage('funcion_notificaciones');
    }

    match /admin/{documentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
